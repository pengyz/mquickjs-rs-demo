# test-app 构建命令
# 用法: just <command>

# 默认命令
default: build

# 构建项目
build:
    cd ../.. && cargo run -p ridl-builder -- prepare
    cd ../.. && cargo build -p test_app

# 运行测试（本应用目录下的 JS 用例，由 demo runner 执行）
test:
    cd ../.. && cargo run -p mquickjs-demo -- apps/test_app/tests

# 清理
clean:
    cd ../.. && cargo clean

# 重新构建
rebuild: clean build