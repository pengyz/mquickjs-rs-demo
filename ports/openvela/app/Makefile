############################################################################
# ports/openvela/app/Makefile — mquickjs `js` NSH builtin (OpenVela sim).
#
# SOURCE-LEVEL integration (mirrors apps/interpreters/quickjs): the engine's
# .c files are compiled here by the NuttX toolchain, so every libc binding
# (setjmp/longjmp, malloc/free, ...) resolves to the NuttX side consistently.
#
# stdlib = RIDL variant (M1-R+): the runtime TU mqjs_stdlib_impl.c (from
# deps/mquickjs-rs) defines the strong `js_stdlib` with the RIDL extension
# tables (console -> Rust adapter), the app aggregate provides the register
# TU (JS_RIDL_StdlibInit + require table), and require.c implements
# require(). The base deps/mquickjs/mqjs_stdlib.c is NOT compiled here.
#
# Headers: gen/ carries mquickjs_atom.h + mqjs_ridl_stdlib.h, generated by
# the engine's OWN host toolchain from mqjs_stdlib_template.c (see
# ports/openvela/setup-sim.sh). The aggregate headers live in
# MQJS_AGG_DIR (ports/openvela/rust/target/ridl/apps/<app>/aggregate).
# Both gen/, engine_src/ and the aggregate are machine-local, gitignored.
############################################################################

include $(APPDIR)/Make.defs

-include $(APPDIR)$(DELIM)system$(DELIM)mqjs$(DELIM)framework.mk

MQJS_GEN_DIR ?= $(error MQJS_GEN_DIR not set: run ports/openvela/setup-sim.sh first)
MQJS_ENGINE_SRC ?= $(error MQJS_ENGINE_SRC not set: run ports/openvela/setup-sim.sh first)
MQJS_AGG_DIR ?= $(error MQJS_AGG_DIR not set: run ports/openvela/setup-sim.sh first)

# Engine core + ridl-variant stdlib runtime TUs, staged under engine_src/ by
# setup-sim.sh (core from deps/mquickjs, stdlib/require from deps/mquickjs-rs,
# register from the app aggregate).
MQJS_ENGINE_SRCS = mquickjs.c cutils.c dtoa.c libm.c \
	mqjs_stdlib_impl.c mqjs_require.c mqjs_ridl_register.c

CSRCS += $(foreach f,$(MQJS_ENGINE_SRCS),engine_src/$(f))

# Engine compile flags (mirrors deps/mquickjs/Makefile target CFLAGS minus
# host-specific parts) plus the generated atom-table headers, the engine
# source dir (private headers) and the aggregate dir (RIDL register/api).
# -DMQUICKJS_ENABLE_RIDL_EXTENSIONS selects the strong-`js_stdlib` linkage
# and the RIDL code paths — the whole app TU set shares one macro
# environment, same as the mquickjs-build ridl variant.
CFLAGS += -I$(MQJS_GEN_DIR)
CFLAGS += -I$(MQJS_AGG_DIR)
CFLAGS += -I$(MQJS_ENGINE_SRC) -Iengine_src
# One macro environment for the whole app TU set (same as the mquickjs-build
# ridl variant): the extension switch selects the strong-`js_stdlib` linkage
# and RIDL code paths; the force-included api header declares the RIDL
# js_* entry points that the generated stdlib table references from
# mqjs_stdlib_impl.o, and the hooks header declares the rs probe overlay
# hooks baked into the same table (setup-sim.sh steps 1b/2a).
CFLAGS += -DMQUICKJS_ENABLE_RIDL_EXTENSIONS
CFLAGS += -include mquickjs_ridl_api.h
CFLAGS += -include mqjs_rs_hooks.h
CFLAGS += -fno-math-errno -fno-trapping-math

PROGNAME  = $(CONFIG_MQJS_JS_PROGNAME)
PRIORITY  = $(CONFIG_MQJS_JS_PRIORITY)
STACKSIZE = $(CONFIG_MQJS_JS_STACKSIZE)
MAINSRC = js_main.c

include $(APPDIR)/Application.mk
