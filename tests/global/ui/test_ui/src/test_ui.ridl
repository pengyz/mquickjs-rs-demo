mode strict;

singleton UI {
    // 创建元素
    fn createElement(type: string) -> i32;
    
    // 设置属性
    fn setProperty(elementId: i32, key: string, value: string) -> void;
    
    // 添加子元素
    fn appendChild(parentId: i32, childId: i32) -> void;
    
    // 获取属性
    fn getProperty(elementId: i32, key: string) -> string;
    
    // 渲染
    fn render() -> void;
}